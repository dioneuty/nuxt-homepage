generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminBoard {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model AdminGalleryItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model BlogPost {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  categoryId Int
  createdAt  DateTime @default(now())
  Category   Category @relation(fields: [categoryId], references: [id])
}

model BoardPost {
  id              Int         @id @default(autoincrement())
  title           String?
  content         String
  author          String
  createdAt       DateTime    @default(now())
  parentId        Int?
  BoardPost       BoardPost?  @relation("BoardPostToBoardPost", fields: [parentId], references: [id], onDelete: Cascade)
  other_BoardPost BoardPost[] @relation("BoardPostToBoardPost")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  slug     String     @unique
  BlogPost BlogPost[]
}

model Chat {
  id        Int      @id @default(autoincrement())
  screenId  String?  @unique
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime
  userId    Int?
  User      User?    @relation(fields: [userId], references: [id])
}

model Contact {
  id        Int      @id @default(autoincrement())
  author    String
  email     String?
  title     String
  content   String
  createdAt DateTime @default(now())
}

model GalleryComment {
  id            Int         @id @default(autoincrement())
  content       String
  author        String?
  authorId      Int?
  createdAt     DateTime    @default(now())
  galleryItemId Int
  GalleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id])
}

model GalleryItem {
  id             Int              @id @default(autoincrement())
  title          String
  description    String
  content        String?
  tags           String[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  GalleryComment GalleryComment[]
}

model Holiday {
  id    Int    @id @default(autoincrement())
  year  Int
  month Int
  day   Int
  name  String
}

model HumorPost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String
  createdAt DateTime @default(now())
  likes     Int      @default(0)
}

model Image {
  id  Int    @id @default(autoincrement())
  url String
  alt String
}

model Menu {
  id         Int      @id @default(autoincrement())
  name       String
  path       String?
  icon       String?
  role       String?  @default("public")
  order      Int      @default(0)
  parentId   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Menu       Menu?    @relation("MenuToMenu", fields: [parentId], references: [id], onDelete: Cascade)
  other_Menu Menu[]   @relation("MenuToMenu")
}

model OutlineItem {
  id                String        @id
  content           String
  parentId          String?
  order             Int?
  OutlineItem       OutlineItem?  @relation("OutlineItemToOutlineItem", fields: [parentId], references: [id])
  other_OutlineItem OutlineItem[] @relation("OutlineItemToOutlineItem")
}

model OutlineState {
  id        Int      @id @default(autoincrement())
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model QnA {
  id              Int       @id @default(autoincrement())
  questionTitle   String
  questionContent String
  answerContent   String?
  author          String
  answerer        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime?
}

model RelatedSite {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  description String?
  order       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model SiteConfig {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  darkFooterColor      String   @default("#1A202C")
  darkHeaderColor      String   @default("#1A202C")
  lightFooterColor     String   @default("#F7FAFC")
  lightHeaderColor     String   @default("#FFFFFF")
  darkBackgroundColor  String   @default("#1A202C")
  lightBackgroundColor String   @default("#FFFFFF")
  siteLogoUrl          String?  @default("/images/logo.png")
  siteTitle            String   @default("My Website")
  siteLogoIcon         String?
  showSiteLogoIcon     Boolean  @default(true)
  showSiteLogoUrl      Boolean  @default(true)
  showSiteTitle        Boolean  @default(true)
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String   @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime
  isActive  Boolean  @default(true)
  Chat      Chat[]
}

model Wiki {
  id        Int       @id @default(autoincrement())
  title     String?
  content   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  author    String?
  createdBy String?
  updatedBy String?
}

model YouTubeVideo {
  id                   Int                   @id @default(autoincrement())
  videoId              String                @unique
  title                String
  description          String
  isShort              Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  categoryId           Int?
  isPlayable           Boolean               @default(true)
  uploadedAt           DateTime?
  YouTubeVideoCategory YouTubeVideoCategory? @relation(fields: [categoryId], references: [id])
}

model YouTubeVideoCategory {
  id           Int            @id @default(autoincrement())
  name         String
  slug         String         @unique
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  YouTubeVideo YouTubeVideo[]
}

model guestbook_comments {
  id          Int        @id @default(autoincrement())
  content     String
  author      String?
  password    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  guestbookId Int
  guestbooks  guestbooks @relation(fields: [guestbookId], references: [id])
}

model guestbooks {
  id                 Int                  @id @default(autoincrement())
  title              String
  content            String
  author             String?
  password           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  guestbook_comments guestbook_comments[]
}
